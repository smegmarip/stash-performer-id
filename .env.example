# Copy to .env and fill in. Secrets (STASH_API_KEY, PARSE_BOT_API_KEY) never committed.

# Ports (compose). SERVICE_PORT is the single knob for the service — it drives the container
# port mapping, the container's PORT, and the viewer's API target.
SERVICE_PORT=15000
VIEWER_PORT=15001
# Override the service's advertised base URL (defaults to http://localhost:${SERVICE_PORT}).
# PUBLIC_BASE_URL=

# Stash connection (harvest + stash-box surface). In compose the default is
# host.docker.internal:9999 (the host's Stash); override for a different instance.
STASH_URL=http://host.docker.internal:9999
STASH_API_KEY=

# Enrichment (parse.bot / thehandbook)
PARSE_BOT_API_KEY=

# Harvest
TOP_FOLDER=
# Host path mounted read-only at /data (compose MEDIA_ROOT_HOST)
MEDIA_ROOT_HOST=./data

# Storage
DB_PATH=/cache/stash-performer-id.sqlite
