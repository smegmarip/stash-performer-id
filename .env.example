# Copy to .env and fill in. Secrets (STASH_API_KEY, PARSE_BOT_API_KEY) never committed.

# Ports (compose). SERVICE_PORT is the single knob for the service — it drives the container
# port mapping, the container's PORT, and the viewer's API target.
SERVICE_PORT=15000
VIEWER_PORT=15001
# Override the service's advertised base URL (defaults to http://localhost:${SERVICE_PORT}).
# Must be reachable by Stash (and, for in-UI image previews, the browser) — used for the stash-box
# endpoint and the image proxy below. Set to the host's LAN IP when Stash runs in a container.
# PUBLIC_BASE_URL=

# Image hosts whose enrichment images block direct hotlinks — refetched via /image-proxy before the
# URL is handed to Stash. Comma-separated host suffixes; "*" proxies all. Needs PUBLIC_BASE_URL set.
# IMAGE_PROXY_HOSTS=thehandbook.com

# Stash connection (harvest + stash-box surface). In compose the default is
# host.docker.internal:9999 (the host's Stash); override for a different instance.
STASH_URL=http://host.docker.internal:9999
STASH_API_KEY=

# Enrichment (parse.bot / thehandbook)
PARSE_BOT_API_KEY=

# FlareSolverr — solves Babepedia's Cloudflare challenge (cloudscraper is tried first; this is
# only the fallback). The default is a container URL: Docker resolves the name on a shared network,
# so no IP is needed. Two ways to satisfy it:
#   1. FlareSolverr already runs on another Docker network — join it via DOCKER_NETWORK (below)
#      so its container name resolves, and set the URL to that container:
#        FLARESOLVERR_URL=http://flaresolverr:8191/v1   (the default; change the name if it differs)
#   2. No FlareSolverr reachable — start the bundled sidecar via its compose profile:
#        COMPOSE_PROFILES=flaresolverr        (or: docker compose --profile flaresolverr up)
# Leave the default unless your FlareSolverr is reachable at a different name/port.
# FLARESOLVERR_URL=http://flaresolverr:8191/v1
# FLARESOLVERR_PORT=8191        # host port published by the bundled sidecar (profile only)
# FLARESOLVERR_LOG_LEVEL=info   # bundled sidecar log level (profile only)

# The single Docker network the whole stack runs on, so it can reach containers on it — e.g. a
# FlareSolverr running elsewhere — by name. It MUST already exist (external), with that container
# attached:
#   docker network create stash_network
#   docker network connect stash_network <your-flaresolverr-container>
# Use a user-defined network (not the default `bridge`, which has no name resolution).
DOCKER_NETWORK=stash_network

# Harvest
TOP_FOLDER=
# Host path mounted read-only at /data (compose MEDIA_ROOT_HOST)
MEDIA_ROOT_HOST=./data

# Storage
# Host dir for the writable cache/SQLite DB, mounted at /cache. MUST be writable by the
# container user (UID 1000). The default ./cache is auto-created by the Docker daemon as root
# and will fail with "unable to open database file" — point this at a dir you own, or pre-create
# and chown it: `mkdir -p /srv/spid-cache && sudo chown 1000:1000 /srv/spid-cache`.
CACHE_ROOT_HOST=./cache
# Container path of the DB file (its directory must live under the /cache mount above).
DB_PATH=/cache/stash-performer-id.sqlite
